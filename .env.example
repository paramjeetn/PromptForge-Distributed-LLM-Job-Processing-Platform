# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=

# ─── GCS ──────────────────────────────────────────────────────────────────────
GCS_INPUT_BUCKET=promptforge-input
GCS_OUTPUT_BUCKET=promptforge-output

# ─── Firestore ────────────────────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=

# ─── Unkey (API key management) ───────────────────────────────────────────────
UNKEY_API_ID=
UNKEY_ROOT_KEY=

# ─── GKE (used by launcher to create execution pods) ──────────────────────────
GKE_CLUSTER_NAME=
GKE_CLUSTER_LOCATION=
GKE_NAMESPACE=default
EXECUTION_IMAGE=

# ─── API Service ──────────────────────────────────────────────────────────────
PORT=8080

# ─── Execution Pod (injected by launcher as K8s env vars) ─────────────────────
# These are set per-job at pod creation time — do not set globally.
# Listed here for documentation purposes only.
# JOB_ID=
# CLIENT_ID=
# PROVIDER=
# MODEL=
# RPM_LIMIT=
# TPM_LIMIT=
# MAX_RETRIES=
# PROMPTS_PATH=
# PROMPT_COUNT=
# INPUT_BUCKET=
# OUTPUT_BUCKET=

# ─── Observability — Axiom ────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
OTEL_SERVICE_NAME=promptforge
AXIOM_TOKEN=

# ─── Observability — Sentry ───────────────────────────────────────────────────
SENTRY_DSN=

# ─── Local Dev ────────────────────────────────────────────────────────────────
# Used by docker-compose / scripts only. Not deployed to GCP.
MOCK_PROVIDER_PORT=9000
MOCK_PROVIDER_RPM_LIMIT=100
