# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=promptforge-1212
GCP_REGION=us-central1

# ─── GCS ──────────────────────────────────────────────────────────────────────
GCS_INPUT_BUCKET=promptforge-input-promptforge-1212
GCS_OUTPUT_BUCKET=promptforge-output-promptforge-1212

# ─── Firestore ────────────────────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=promptforge-1212

# ─── Unkey (API key management) ───────────────────────────────────────────────
UNKEY_API_ID=
UNKEY_ROOT_KEY=

# ─── GKE (used by launcher to create execution pods) ──────────────────────────
GKE_CLUSTER_NAME=
GKE_CLUSTER_LOCATION=
GKE_NAMESPACE=default
EXECUTION_IMAGE=

# ─── API Service ──────────────────────────────────────────────────────────────
PORT=8080

# ─── Execution Pod (injected by launcher as K8s env vars) ─────────────────────
# These are set per-job at pod creation time — do not set globally.
# Listed here for documentation purposes only.
# JOB_ID=
# CLIENT_ID=
# PROVIDER=
# MODEL=
# RPM_LIMIT=
# TPM_LIMIT=
# MAX_RETRIES=
# PROMPTS_PATH=
# PROMPT_COUNT=
# INPUT_BUCKET=
# OUTPUT_BUCKET=

# ─── Observability — Axiom (OTel traces + logs) ──────────────────────────────
AXIOM_API_KEY=
AXIOM_DATASET=promptforge

# ─── Observability — Sentry (error tracking) ─────────────────────────────────
SENTRY_DSN=

# ─── Local Dev ────────────────────────────────────────────────────────────────
# Used by docker-compose / scripts only. Not deployed to GCP.
MOCK_PROVIDER_PORT=9000
MOCK_PROVIDER_RPM_LIMIT=100

# Service account to impersonate for V4 signed URLs when running locally with
# `gcloud auth application-default login` (user credentials can't sign directly).
# Requires the logged-in user to have roles/iam.serviceAccountTokenCreator on this SA.
# Defaults to: promptforge-api@<GCP_PROJECT_ID>.iam.gserviceaccount.com
# SIGNING_SERVICE_ACCOUNT=promptforge-api@promptforge-1212.iam.gserviceaccount.com
